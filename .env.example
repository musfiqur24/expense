# Used by docker-compose.yml
NODE_ENV=production
PORT=5000
MONGO_URI=mongodb://mongo:27017/expense_tracker
# Public address where the browser loads the app. For production use your HTTPS domain.
FRONTEND_URL=https://northstar-expense.mywire.org
CORS_ORIGIN=https://northstar-expense.mywire.org

# Create a Web application OAuth client in Google Cloud Console. Add this exact
# callback URL to its Authorized redirect URIs (use your production domain when deployed).
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=https://northstar-expense.mywire.org/api/auth/google/callback

# Use a long random value in deployment. HTTPS deployments should set this true.
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=true
